# Secure Uploads Directory Lockdown
# Deny execution of server-side scripts
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|exe|sh|html|htm|js)$">
  Order Deny,Allow
  Deny from all
</FilesMatch>

# Disable script handlers
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>

Options -Indexes -ExecCGI
